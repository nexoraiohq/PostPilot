rules_version = '2';

// Collins Reserve — Firestore Security Rules
//
// Trust model:
//  - Public visitors read menu/brand data, create orders and reservation
//    requests, and fetch a single document by its full reference for tracking.
//  - Order totals are recomputed here from menuItems (the rules language has
//    no loops, so validation is unrolled for up to 8 lines / 3 variants /
//    3 add-ons — mirrored by MAX_ORDER_LINES and menu validation below).
//  - Reservation capacity is locked via reservationSlots: public clients may
//    only increase `taken`, never exceed capacity and never lower it; only
//    staff can release seats (on cancellation).
//  - Staff privileges come from users/{uid}.role + users/{uid}.restaurantId,
//    written by the Admin SDK only (clients can never set their own role).
//  - Status changes validate explicit transitions and are field-restricted.
//
// Demo note: orders/reservations are readable by anyone who knows the full
// reference (e.g. MN-483920) so customers can track without an account.
// References are random 6-digit values — do not reuse this pattern for
// sensitive production data without authentication.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaffOf(rid) {
      return signedIn()
        && profile().restaurantId == rid
        && profile().role in ['admin', 'manager', 'staff'];
    }

    function isAnyManager() {
      return signedIn() && profile().role in ['admin', 'manager'];
    }

    function validStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // ------------------------------------------------------------------
    // Restaurants & settings (public read, staff write)
    // ------------------------------------------------------------------
    match /restaurants/{rid} {
      allow read: if true;
      allow write: if isStaffOf(rid);
    }

    match /settings/{rid} {
      allow read: if true;
      allow write: if isStaffOf(rid);
    }

    // ------------------------------------------------------------------
    // Users (profiles are created by the Admin SDK only)
    // ------------------------------------------------------------------
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAnyManager());
      allow list: if isAnyManager();
      allow create: if false;
      allow update: if (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayName', 'updatedAt']))
        || (isAnyManager()
          && request.resource.data.role in ['admin', 'manager', 'staff']
          && request.resource.data.restaurantId == resource.data.restaurantId
          && request.resource.data.email == resource.data.email);
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Menu
    // ------------------------------------------------------------------
    match /menuCategories/{id} {
      allow read: if true;
      allow create, update: if isStaffOf(request.resource.data.restaurantId)
        && validStr(request.resource.data.name, 2, 60)
        && validStr(request.resource.data.slug, 2, 60)
        && request.resource.data.sortOrder is int;
      allow delete: if isStaffOf(resource.data.restaurantId);
    }

    match /menuItems/{id} {
      allow read: if true;
      allow create, update: if isStaffOf(request.resource.data.restaurantId)
        && validStr(request.resource.data.name, 2, 120)
        && validStr(request.resource.data.description, 2, 600)
        && validStr(request.resource.data.categoryId, 1, 60)
        && request.resource.data.priceKes is int
        && request.resource.data.priceKes >= 50
        && request.resource.data.priceKes <= 1000000
        && request.resource.data.available is bool
        && request.resource.data.featured is bool
        && request.resource.data.sortOrder is int
        && request.resource.data.tags is list
        && request.resource.data.variants is list
        && request.resource.data.variants.size() <= 3
        && request.resource.data.addons is list
        && request.resource.data.addons.size() <= 3
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 600;
      allow delete: if isStaffOf(resource.data.restaurantId);
    }

    match /services/{id} {
      allow read: if true;
      allow create, update: if isStaffOf(request.resource.data.restaurantId)
        && validStr(request.resource.data.name, 2, 120);
      allow delete: if isStaffOf(resource.data.restaurantId);
    }

    match /tables/{id} {
      allow read: if true;
      allow create, update: if isStaffOf(request.resource.data.restaurantId)
        && validStr(request.resource.data.name, 1, 40)
        && request.resource.data.seats is int
        && request.resource.data.seats >= 1
        && request.resource.data.seats <= 40
        && request.resource.data.active is bool;
      allow delete: if isStaffOf(resource.data.restaurantId);
    }

    // ------------------------------------------------------------------
    // Orders
    // ------------------------------------------------------------------
    match /orders/{orderId} {
      function d() {
        return request.resource.data;
      }

      // Price delta for a selected variant; -1 = variant not offered on item.
      function variantDelta(variants, vid, vname) {
        return vid == null ? 0
          : variants.size() == 0 ? -1
          : variants[0].id == vid && variants[0].name == vname ? variants[0].priceDeltaKes
          : variants.size() == 1 ? -1
          : variants[1].id == vid && variants[1].name == vname ? variants[1].priceDeltaKes
          : variants.size() == 2 ? -1
          : variants[2].id == vid && variants[2].name == vname ? variants[2].priceDeltaKes
          : -1;
      }

      function addonMatches(addons, la) {
        return addons.size() == 0 ? false
          : addons[0].id == la.id && addons[0].name == la.name && addons[0].priceKes == la.priceKes ? true
          : addons.size() == 1 ? false
          : addons[1].id == la.id && addons[1].name == la.name && addons[1].priceKes == la.priceKes ? true
          : addons.size() == 2 ? false
          : addons.size() == 3 && addons[2].id == la.id && addons[2].name == la.name && addons[2].priceKes == la.priceKes;
      }

      function lineAddonsValid(itemAddons, las) {
        return las.size() == 0 ? true
          : las.size() == 1 ? addonMatches(itemAddons, las[0])
          : las.size() == 2 ? addonMatches(itemAddons, las[0]) && addonMatches(itemAddons, las[1])
          : las.size() == 3 ? addonMatches(itemAddons, las[0]) && addonMatches(itemAddons, las[1]) && addonMatches(itemAddons, las[2])
          : false;
      }

      function addonPrice(addons, aid) {
        return addons.size() == 0 ? -1000000000
          : addons[0].id == aid ? addons[0].priceKes
          : addons.size() == 1 ? -1000000000
          : addons[1].id == aid ? addons[1].priceKes
          : addons.size() == 2 ? -1000000000
          : addons.size() == 3 && addons[2].id == aid ? addons[2].priceKes
          : -1000000000;
      }

      function lineAddonsSum(itemAddons, las) {
        return las.size() == 0 ? 0
          : las.size() == 1 ? addonPrice(itemAddons, las[0].id)
          : las.size() == 2 ? addonPrice(itemAddons, las[0].id) + addonPrice(itemAddons, las[1].id)
          : las.size() == 3 ? addonPrice(itemAddons, las[0].id) + addonPrice(itemAddons, las[1].id) + addonPrice(itemAddons, las[2].id)
          : -1000000000;
      }

      // One authoritative fetch + full recomputation of a line.
      function verifyLine(order, line) {
        let item = get(/databases/$(database)/documents/menuItems/$(line.itemId)).data;
        let vdelta = variantDelta(item.variants, line.variantId, line.variantName);
        let addonsSum = lineAddonsSum(item.addons, line.addons);
        let unit = item.priceKes + vdelta + addonsSum;
        return item.available == true
          && item.restaurantId == order.restaurantId
          && line.name == item.name
          && line.quantity is int
          && line.quantity >= 1
          && line.quantity <= 20
          && vdelta >= 0
          && lineAddonsValid(item.addons, line.addons)
          && (line.variantId == null ? line.variantName == null : true)
          && line.unitPriceKes == unit
          && line.lineTotalKes == unit * line.quantity;
      }

      function allLinesValid(order, items) {
        return items.size() == 1 ? verifyLine(order, items[0])
          : items.size() == 2 ? verifyLine(order, items[0]) && verifyLine(order, items[1])
          : items.size() == 3 ? verifyLine(order, items[0]) && verifyLine(order, items[1]) && verifyLine(order, items[2])
          : items.size() == 4 ? verifyLine(order, items[0]) && verifyLine(order, items[1]) && verifyLine(order, items[2]) && verifyLine(order, items[3])
          : items.size() == 5 ? verifyLine(order, items[0]) && verifyLine(order, items[1]) && verifyLine(order, items[2]) && verifyLine(order, items[3]) && verifyLine(order, items[4])
          : items.size() == 6 ? verifyLine(order, items[0]) && verifyLine(order, items[1]) && verifyLine(order, items[2]) && verifyLine(order, items[3]) && verifyLine(order, items[4]) && verifyLine(order, items[5])
          : items.size() == 7 ? verifyLine(order, items[0]) && verifyLine(order, items[1]) && verifyLine(order, items[2]) && verifyLine(order, items[3]) && verifyLine(order, items[4]) && verifyLine(order, items[5]) && verifyLine(order, items[6])
          : items.size() == 8 ? verifyLine(order, items[0]) && verifyLine(order, items[1]) && verifyLine(order, items[2]) && verifyLine(order, items[3]) && verifyLine(order, items[4]) && verifyLine(order, items[5]) && verifyLine(order, items[6]) && verifyLine(order, items[7])
          : false;
      }

      function itemsSubtotal(items) {
        return items.size() == 0 ? 0
          : items.size() == 1 ? items[0].lineTotalKes
          : items.size() == 2 ? items[0].lineTotalKes + items[1].lineTotalKes
          : items.size() == 3 ? items[0].lineTotalKes + items[1].lineTotalKes + items[2].lineTotalKes
          : items.size() == 4 ? items[0].lineTotalKes + items[1].lineTotalKes + items[2].lineTotalKes + items[3].lineTotalKes
          : items.size() == 5 ? items[0].lineTotalKes + items[1].lineTotalKes + items[2].lineTotalKes + items[3].lineTotalKes + items[4].lineTotalKes
          : items.size() == 6 ? items[0].lineTotalKes + items[1].lineTotalKes + items[2].lineTotalKes + items[3].lineTotalKes + items[4].lineTotalKes + items[5].lineTotalKes
          : items.size() == 7 ? items[0].lineTotalKes + items[1].lineTotalKes + items[2].lineTotalKes + items[3].lineTotalKes + items[4].lineTotalKes + items[5].lineTotalKes + items[6].lineTotalKes
          : items.size() == 8 ? items[0].lineTotalKes + items[1].lineTotalKes + items[2].lineTotalKes + items[3].lineTotalKes + items[4].lineTotalKes + items[5].lineTotalKes + items[6].lineTotalKes + items[7].lineTotalKes
          : 0;
      }

      function itemsQuantity(items) {
        return items.size() == 0 ? 0
          : items.size() == 1 ? items[0].quantity
          : items.size() == 2 ? items[0].quantity + items[1].quantity
          : items.size() == 3 ? items[0].quantity + items[1].quantity + items[2].quantity
          : items.size() == 4 ? items[0].quantity + items[1].quantity + items[2].quantity + items[3].quantity
          : items.size() == 5 ? items[0].quantity + items[1].quantity + items[2].quantity + items[3].quantity + items[4].quantity
          : items.size() == 6 ? items[0].quantity + items[1].quantity + items[2].quantity + items[3].quantity + items[4].quantity + items[5].quantity
          : items.size() == 7 ? items[0].quantity + items[1].quantity + items[2].quantity + items[3].quantity + items[4].quantity + items[5].quantity + items[6].quantity
          : items.size() == 8 ? items[0].quantity + items[1].quantity + items[2].quantity + items[3].quantity + items[4].quantity + items[5].quantity + items[6].quantity + items[7].quantity
          : 0;
      }

      function deliveryShape(order) {
        return order.type == 'delivery'
          ? (order.delivery is map
              && validStr(order.delivery.address, 5, 300)
              && validStr(order.delivery.area, 1, 60))
          : order.delivery == null;
      }

      // Fees recomputed from settings. serviceCharge uses integer
      // half-up rounding: (raw + 50) / 100 with truncating division.
      function totalsMatch(order, subtotal, count) {
        let settings = get(/databases/$(database)/documents/settings/$(order.restaurantId)).data;
        let fee = order.type == 'delivery'
          ? (settings.freeDeliveryOverKes != null && subtotal >= settings.freeDeliveryOverKes
              ? 0
              : settings.deliveryFeeKes)
          : 0;
        let svc = (subtotal * settings.serviceChargePercent + 50) / 100;
        return (order.type == 'delivery' ? settings.acceptDelivery == true : settings.acceptPickup == true)
          && order.subtotalKes == subtotal
          && order.itemCount == count
          && order.deliveryFeeKes == fee
          && order.serviceChargeKes == svc
          && order.totalKes == subtotal + fee + svc
          && order.paymentMethod == 'pay_on_collection';
      }

      function validCreation() {
        let items = d().items;
        let subtotal = itemsSubtotal(items);
        let count = itemsQuantity(items);
        return orderId.matches('^MN-[0-9]{6}$')
          && d().restaurantId == 'maison-noir'
          && d().status == 'received'
          && d().cancelReason == null
          && d().type in ['pickup', 'delivery']
          && items is list
          && items.size() >= 1
          && items.size() <= 8
          && d().timeline is list
          && d().timeline.size() == 1
          && d().timeline[0].status == 'received'
          && d().customer is map
          && validStr(d().customer.name, 2, 100)
          && validStr(d().customer.phone, 9, 15)
          && d().paymentMethod is string
          && d().itemCount is int
          && d().subtotalKes is int
          && d().totalKes is int
          && allLinesValid(d(), items)
          && deliveryShape(d())
          && totalsMatch(d(), subtotal, count);
      }

      function validTransition(from, to) {
        return from == 'received' ? to in ['accepted', 'rejected', 'cancelled']
          : from == 'accepted' ? to in ['preparing', 'cancelled']
          : from == 'preparing' ? to in ['ready', 'cancelled']
          : from == 'ready' ? to == 'completed'
          : false;
      }

      function validStatusUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return d().restaurantId == resource.data.restaurantId
          && validTransition(resource.data.status, d().status)
          && d().totalKes == resource.data.totalKes
          && d().subtotalKes == resource.data.subtotalKes
          && d().items == resource.data.items
          && d().createdAt == resource.data.createdAt
          && d().customer == resource.data.customer
          && d().timeline.size() == resource.data.timeline.size() + 1
          && d().statusUpdatedAt >= resource.data.statusUpdatedAt
          && changed.hasOnly(['status', 'timeline', 'cancelReason', 'updatedAt', 'statusUpdatedAt']);
      }

      // Public tracking: fetch one order by its full reference.
      allow get: if orderId.matches('^MN-[0-9]{6}$');
      allow list: if isStaffOf(resource.data.restaurantId);
      allow create: if validCreation();
      allow update: if isStaffOf(resource.data.restaurantId) && validStatusUpdate();
      allow delete: if false;
    }

    match /orders/{orderId}/events/{eventId} {
      allow get: if orderId.matches('^MN-[0-9]{6}$');
      allow list: if isStaffOf(get(/databases/$(database)/documents/orders/$(orderId)).data.restaurantId);
      allow create: if isStaffOf(get(/databases/$(database)/documents/orders/$(orderId)).data.restaurantId)
        && request.resource.data.status is string
        && request.resource.data.at is int;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // Reservations
    // ------------------------------------------------------------------
    match /reservations/{resId} {
      function d() {
        return request.resource.data;
      }

      function validCreation() {
        return resId.matches('^MN-R[0-9]{6}$')
          && d().restaurantId == 'maison-noir'
          && d().status == 'pending'
          && d().termsAccepted == true
          && validStr(d().guestName, 2, 100)
          && validStr(d().guestPhone, 9, 15)
          && d().partySize is int
          && d().partySize >= 1
          && d().partySize <= 30
          && d().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d().time.matches('^[0-9]{2}:[0-9]{2}$')
          && d().slotId == d().date + '--' + d().time
          && d().seatingPreference in ['any', 'indoor', 'terrace', 'window']
          && (d().guestEmail is string ? d().guestEmail.size() <= 200 : false)
          && (d().notes is string ? d().notes.size() <= 1000 : false);
      }

      function validTransition(from, to) {
        return from == 'pending' ? to in ['confirmed', 'cancelled']
          : from == 'confirmed' ? to in ['completed', 'cancelled', 'no_show']
          : false;
      }

      function validStatusUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return d().restaurantId == resource.data.restaurantId
          && validTransition(resource.data.status, d().status)
          && d().date == resource.data.date
          && d().time == resource.data.time
          && d().partySize == resource.data.partySize
          && d().slotId == resource.data.slotId
          && d().guestPhone == resource.data.guestPhone
          && d().createdAt == resource.data.createdAt
          && changed.hasOnly(['status', 'updatedAt', 'statusNote']);
      }

      allow get: if resId.matches('^MN-R[0-9]{6}$') || isStaffOf(resource.data.restaurantId);
      allow list: if isStaffOf(resource.data.restaurantId);
      allow create: if validCreation();
      allow update: if isStaffOf(resource.data.restaurantId) && validStatusUpdate();
      allow delete: if false;
    }

    // Slot locks: the concurrency primitive for bookings.
    match /reservationSlots/{slotId} {
      allow get: if true;
      allow list: if true;

      allow create: if request.resource.data.capacity is int
        && request.resource.data.capacity > 0
        && request.resource.data.taken is int
        && request.resource.data.taken >= 0
        && request.resource.data.taken <= request.resource.data.capacity
        && request.resource.data.date + '--' + request.resource.data.time == slotId
        && request.resource.data.restaurantId is string;

      allow update: if (
          // Public booking: seats may only move upward, within capacity.
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['taken', 'updatedAt'])
          && request.resource.data.taken is int
          && request.resource.data.taken >= resource.data.taken
          && request.resource.data.taken <= resource.data.capacity
          && request.resource.data.capacity == resource.data.capacity
        ) || (
          // Staff may release or reassign seats (cancellations, walk-ins).
          isStaffOf(resource.data.restaurantId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['taken', 'capacity', 'updatedAt'])
          && request.resource.data.taken is int
          && request.resource.data.taken >= 0
          && request.resource.data.taken <= request.resource.data.capacity
        );

      allow delete: if isStaffOf(resource.data.restaurantId);
    }

    // Reserved: not used by the client. Locked explicitly.
    match /customers/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
