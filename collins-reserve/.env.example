# Firebase web app configuration (Settings → General → Your apps).
# These values identify your project and are safe to expose in the client
# bundle — access is enforced by Firestore Security Rules, not by these keys.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Document id of the restaurant (restaurants/{id}) used by the whole app.
VITE_RESTAURANT_ID=maison-noir
