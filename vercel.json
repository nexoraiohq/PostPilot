{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "collins-reserve": {
      "root": "collins-reserve",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/settings", "destination": "/index.html" },
        { "source": "/new", "destination": "/index.html" },
        { "source": "/item/:id", "destination": "/index.html" },
        { "source": "/share/:id", "destination": "/index.html" }
      ]
    },
    "postpilot-api": {
      "root": "collins-reserve/functions",
      "framework": "express",
      "entrypoint": "lib/server.js",
      "buildCommand": "npm run build",
      "functions": {
        "**/*.js": { "maxDuration": 60 }
      }
    }
  },
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": { "service": "postpilot-api" }
    },
    { "source": "/(.*)", "destination": { "service": "collins-reserve" } }
  ]
}
